{
  "name": "production-cost-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "dev": "node --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "import": "node --env-file-if-exists=.env src/cli.js",
    "alerts:check": "node --env-file-if-exists=.env src/alert-cli.js --check",
    "alerts:test": "node --env-file-if-exists=.env src/alert-cli.js --test",
    "alerts:send": "node --env-file-if-exists=.env src/alert-cli.js",
    "test": "node --test --test-concurrency=1",
    "vendor": "node vendor-c-mock/server.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "lucide": "^1.59.0",
    "multer": "^2.4.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
